      "matched_words": 0
    },
    {
      "index": 2,
      "section": "verse 1",
      "start": 25.37,
      "end": 38.055,
      "text": "A titan in the labyrinth; a child before an open door—",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 3,
      "section": "verse 1",
      "start": 38.055,
      "end": 54.2,
      "text": "I lift the world with quiet fingers, can’t turn the key I’ve turned before.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 4,
      "section": "pre-chorus",
      "start": 54.2,
      "end": 58.813,
      "text": "Little motions, tiny burdens,",
