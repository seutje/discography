      "start": 80.723,
      "end": 87.643,
      "text": "Oh, the simple breaks me open.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 9,
      "section": "chorus",
      "start": 87.643,
      "end": 94.562,
