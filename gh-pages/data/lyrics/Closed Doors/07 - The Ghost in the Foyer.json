    },
    {
      "start": 101.48,
      "end": 105.2,
      "text": "kept the windows mostly open so the air would feel exchanged"
    },
    {
      "start": 105.2,
      "end": 108.84,
      "text": "but behind the velvet no behind the heavy curtain"
