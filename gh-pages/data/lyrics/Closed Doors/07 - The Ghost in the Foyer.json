    },
    {
      "start": 127.3,
      "end": 131.06,
      "text": "i went there without luggage without leaving any sign"
    },
    {
      "start": 131.06,
      "end": 135.08,
      "text": "just a habit of retreating one room deeper every time"
    },
    {
      "start": 137.0,
      "end": 144.98,
