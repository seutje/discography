    },
    {
      "start": 45.0,
      "end": 52.0,
      "text": "Harbour drawn with little birds And welcome written with sour words"
    },
    {
      "start": 52.0,
      "end": 59.0,
      "text": "A paper loves a tidy coast It leaves out hunger thirst and ghosts"
    },
    {
      "start": 59.0,
      "end": 68.0,
      "text": "It marks the rocks but not the hour Your own two hands forget their power"
    },
    {
      "start": 68.0,
