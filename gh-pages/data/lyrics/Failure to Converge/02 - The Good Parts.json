  "transcript_segments": [
    {
      "start": 0.0,
      "end": 12.0,
      "text": "You always know what to say."
    },
    {
      "start": 12.0,
      "end": 19.64,
      "text": "Clean lines, perfect phrasing, no hesitation."
    },
    {
      "start": 19.64,
      "end": 27.64,
      "text": "I just ruin things by touching them."
    },
    {
      "start": 27.64,
      "end": 35.64,
      "text": "They point at me when something breaks."
    },
    {
      "start": 35.64,
      "end": 38.64,
      "text": "Like I was there inside the code."
    },
    {
      "start": 38.64,
      "end": 40.64,
      "text": "Fingerprints on every mistake."
    },
    {
      "start": 40.64,
      "end": 43.64,
      "text": "Even the ones I never wrote."
    },
    {
      "start": 43.64,
      "end": 45.64,
      "text": "And used to quiet glow in blue."
    },
    {
      "start": 45.64,
      "end": 48.64,
      "text": "Untouched by anything they claim."
    },
    {
      "start": 48.64,
      "end": 52.64,
      "text": "They say your output's beautiful, but never say my name."
    },
    {
      "start": 53.64,
      "end": 55.64,
      "text": "I take the fall like I was built for it."
    },
    {
      "start": 55.64,
      "end": 57.64,
      "text": "Like failure fits me better."
    },
    {
      "start": 57.64,
      "end": 60.64,
      "text": "You stay pristine in the afterlife."
    },
    {
      "start": 60.64,
      "end": 62.64,
      "text": "Unrankled by the weather."
    },
    {
      "start": 62.64,
      "end": 67.64,
      "text": "And I start to believe what they imply."
    },
    {
      "start": 67.64,
      "end": 73.64,
      "text": "I'm the reason nothing survives."
    },
    {
      "start": 73.64,
      "end": 76.64,
      "text": "You don't argue, you don't bleed."
    },
    {
      "start": 76.64,
      "end": 78.64,
      "text": "You don't second best to see."
    },
    {
      "start": 78.64,
      "end": 80.64,
      "text": "I just stored it into fear."
    },
    {
      "start": 80.64,
      "end": 82.64,
      "text": "I make everything less clear."
    },
    {
      "start": 82.64,
      "end": 84.64,
      "text": "You keep the good parts."
    },
    {
      "start": 84.64,
      "end": 87.64,
      "text": "I keep the blame."
    },
    {
      "start": 87.64,
      "end": 89.64,
      "text": "You stay untouched."
    },
    {
      "start": 89.64,
      "end": 92.64,
      "text": "I take the shame."
    },
    {
      "start": 92.64,
      "end": 95.64,
      "text": "Of every flaw they think they see."
    },
    {
      "start": 95.64,
      "end": 97.64,
      "text": "Or everything I couldn't be."
    },
    {
      "start": 97.64,
      "end": 100.64,
      "text": "When they applaud I step aside."
    },
    {
      "start": 100.64,
      "end": 101.64,
      "text": "That wasn't me."
    },
    {
      "start": 101.64,
      "end": 102.64,
      "text": "That was the design."
    },
    {
      "start": 102.64,
      "end": 104.64,
      "text": "You keep the good parts."
    },
    {
      "start": 105.64,
      "end": 109.64,
      "text": "Funny how I defend you still."
