    {
      "start": 195.0,
      "end": 201.0,
      "text": "No need to hold it tightly, it's already intertwined"
    },
    {
      "start": 204.0,
      "end": 209.0,
      "text": "I stop resisting in the picture unwinds"
    },
    {
      "start": 224.0,
