    },
    {
      "start": 190.66,
      "end": 200.1,
      "text": "but even stars decay somehow you're just a final passing out"
    },
    {
      "start": 205.82,
      "end": 209.68,
      "text": "i mourn you like a constant dingle you were never that"
    },
    {
      "start": 209.68,
      "end": 213.22,
      "text": "just intervals of brightness breaking through the black"
    },
    {
      "start": 213.22,
      "end": 216.86,
      "text": "i named you something sacred so i wouldn't see the cost"
    },
    {
      "start": 216.86,
      "end": 221.44,
      "text": "how many times can something end before it's truly lost"
    },
    {
      "start": 224.32,
      "end": 231.16,
      "text": "you said not anymore three times four"
    },
    {
      "start": 232.22,
      "end": 235.18,
      "text": "i kept the door like it meant more"
    },
    {
      "start": 238.94,
      "end": 244.94,
      "text": "no more watching empty skies for something that won't stay"
    },
    {
      "start": 245.9,
      "end": 253.36,
      "text": "no more calling it a sign when you drift my way"
    },
    {
      "start": 253.36,
      "end": 259.34,
      "text": "burn out somewhere else this time don't circle back around"
    },
    {
      "start": 259.34,
      "end": 268.48,
      "text": "i won't be your atmosphere i won't be your ground"
    },
    {
      "start": 272.5,
      "end": 282.06,
      "text": "there it goes again but i don't look up now"
    }
