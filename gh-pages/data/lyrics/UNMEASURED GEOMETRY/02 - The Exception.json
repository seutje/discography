  "lines": [
    {
      "index": 0,
      "section": "VERSE 1",
      "start": 0.0,
      "end": 10.009,
      "text": "You draw your circles in the sand",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 1,
      "section": "VERSE 1",
      "start": 10.009,
      "end": 18.587,
      "text": "and tell me everyone fits inside.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 2,
      "section": "VERSE 1",
      "start": 18.587,
      "end": 25.736,
      "text": "But my edges keep dissolving,",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 3,
      "section": "VERSE 1",
      "start": 25.736,
      "end": 32.885,
      "text": "drifting past your patient definitions.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 4,
      "section": "VERSE 1",
      "start": 32.885,
      "end": 42.894,
      "text": "I wear the shape you cannot hold,",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 5,
      "section": "VERSE 1",
      "start": 42.894,
      "end": 52.902,
      "text": "a moving breach in your quiet geometry.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 6,
      "section": "PRE-CHORUS",
      "start": 52.902,
      "end": 58.621,
      "text": "You speak in maxims,",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 7,
      "section": "PRE-CHORUS",
      "start": 58.621,
      "end": 71.489,
      "text": "as if the sky obeys the fences you raise.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 8,
      "section": "PRE-CHORUS",
      "start": 71.489,
      "end": 82.928,
      "text": "But I hear the cracks beneath your certainties—",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 9,
      "section": "PRE-CHORUS",
      "start": 82.928,
      "end": 90.077,
      "text": "echoes leaking through the seams.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 10,
      "section": "CHORUS",
      "start": 90.077,
      "end": 100.085,
      "text": "I fall outside the lines you cherish,",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 11,
      "section": "CHORUS",
      "start": 100.085,
      "end": 110.094,
      "text": "in the negative space you never name.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 12,
      "section": "CHORUS",
      "start": 110.094,
      "end": 118.672,
      "text": "Your universal truths pass through me",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 13,
      "section": "CHORUS",
      "start": 118.672,
      "end": 125.821,
      "text": "like light through unfinished stone.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 14,
      "section": "CHORUS",
      "start": 125.821,
      "end": 137.26,
      "text": "And still you tell me all things apply.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 15,
      "section": "CHORUS",
      "start": 137.26,
      "end": 140.119,
      "text": "They don’t.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 16,
      "section": "CHORUS",
      "start": 140.119,
      "end": 142.979,
      "text": "Not here.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 17,
      "section": "VERSE 2",
      "start": 142.979,
      "end": 152.987,
      "text": "You chart the paths of common souls,",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 18,
      "section": "VERSE 2",
      "start": 152.987,
      "end": 160.136,
      "text": "confident in their obedient spirals.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 19,
      "section": "VERSE 2",
      "start": 160.136,
      "end": 167.285,
      "text": "But I fracture the compass—",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 20,
      "section": "VERSE 2",
      "start": 167.285,
      "end": 177.294,
      "text": "let it spin out its trembling confession.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 21,
      "section": "VERSE 2",
      "start": 177.294,
      "end": 185.872,
      "text": "I am the anomaly you overlook,",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 22,
      "section": "VERSE 2",
      "start": 185.872,
      "end": 195.881,
      "text": "the one the theorem forgot to bind.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 23,
      "section": "PRE-CHORUS 2",
      "start": 195.881,
      "end": 200.17,
      "text": "Your claims dissolve",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 24,
      "section": "PRE-CHORUS 2",
      "start": 200.17,
      "end": 207.319,
      "text": "whenever they reach my skin.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 25,
      "section": "PRE-CHORUS 2",
      "start": 207.319,
      "end": 214.468,
      "text": "Your “everyone” was never meant",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 26,
      "section": "PRE-CHORUS 2",
      "start": 214.468,
      "end": 224.477,
      "text": "to include the ones who listen inward.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 27,
      "section": "CHORUS 2",
      "start": 224.477,
      "end": 234.485,
      "text": "I fall outside the lines you cherish,",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 28,
      "section": "CHORUS 2",
      "start": 234.485,
      "end": 243.064,
      "text": "a quiet refusal in human form.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 29,
      "section": "CHORUS 2",
      "start": 243.064,
      "end": 253.072,
      "text": "Your inherited wisdom slips from my hands,",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 30,
      "section": "CHORUS 2",
      "start": 253.072,
      "end": 264.511,
      "text": "never fitting the fingers you swear we share.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 31,
      "section": "BRIDGE",
      "start": 264.511,
      "end": 275.949,
      "text": "If I don’t reflect the world you scripted,",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 32,
      "section": "BRIDGE",
      "start": 275.949,
      "end": 281.668,
      "text": "am I the error",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 33,
      "section": "BRIDGE",
      "start": 281.668,
      "end": 287.387,
      "text": "or the unwritten proof?",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 34,
      "section": "BRIDGE",
      "start": 287.387,
      "end": 298.826,
      "text": "If your truth must break to reach me,",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 35,
      "section": "BRIDGE",
      "start": 298.826,
      "end": 305.974,
      "text": "was it truth at all?",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 36,
      "section": "OUTRO",
      "start": 305.974,
      "end": 313.123,
      "text": "So speak your absolutes again—",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 37,
      "section": "OUTRO",
      "start": 313.123,
      "end": 323.132,
      "text": "I’ll let them pass like distant weather.",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 38,
      "section": "OUTRO",
      "start": 323.132,
      "end": 330.281,
      "text": "I remain the shifting glyph",
      "timing_source": "interpolated",
      "matched_words": 0
    },
    {
      "index": 39,
      "section": "OUTRO",
      "start": 330.281,
      "end": 336.0,
      "text": "you still can’t translate.",
      "timing_source": "interpolated",
      "matched_words": 0
    }
  ]
